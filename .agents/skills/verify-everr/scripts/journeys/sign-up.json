[
  {"goto": "/auth/sign-up"},
  {"waitText": "Create your account", "timeout": 90000},
  {"shot": "01-sign-up-form"},
  {"fill": "#name", "value": "${VERIFY_NAME}"},
  {"fill": "#email", "value": "${VERIFY_EMAIL}"},
  {"fill": "#password", "value": "${VERIFY_PASSWORD}"},
  {"click": "button[type=submit]"},
  {"waitText": "Setting up your organization", "timeout": 30000},
  {"shot": "02-organization-setup"},
  {"waitUrl": "^/$", "timeout": 30000},
  {"waitText": "Welcome to Everr", "timeout": 30000},
  {"assertText": "${VERIFY_NAME}"},
  {"shot": "03-home"}
]
