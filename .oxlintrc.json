{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [],
  "categories": {
    "correctness": "off",
    "suspicious": "off",
    "pedantic": "off",
    "perf": "off",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "jsPlugins": ["eslint-plugin-boundaries"],
  "ignorePatterns": [
    "**/routeTree.gen.ts",
    "**/dist/**",
    "**/coverage/**",
    "**/.*/**"
  ],
  "settings": {
    "boundaries/elements": [
      {
        "type": "package",
        "pattern": "packages/*",
        "capture": ["name"]
      }
    ],
    "boundaries/additional-dependency-nodes": [
      {
        "selector": "CallExpression[callee.object.name=vi][callee.property.name=/^(mock|doMock|importActual|importMock)$/] > Literal.arguments:first-child",
        "kind": "value",
        "name": "test-mock"
      },
      {
        "selector": "TSImportType > Literal, TSImportType > TSLiteralType > Literal",
        "kind": "type",
        "name": "import-type"
      },
      {
        "selector": "ImportDeclaration:not([importKind=type]):has(ImportNamespaceSpecifier, ImportDefaultSpecifier) > Literal",
        "kind": "value",
        "name": "module-import"
      }
    ],
    "import/resolver": {
      "typescript": {
        "project": [
          "packages/app/tsconfig.json",
          "packages/cloud/tsconfig.json"
        ],
        "noWarnOnMultipleProjects": true
      }
    }
  },
  "overrides": [
    {
      "files": ["packages/app/**/*", "packages/cloud/**/*"],
      "rules": {
        "boundaries/dependencies": [
          "error",
          {
            "default": "disallow",
            "checkAllOrigins": true,
            "checkUnknownLocals": true,
            "checkInternals": true,
            "policies": [
              {
                "allow": {
                  "to": {
                    "module": {
                      "origin": ["core", "external"]
                    }
                  },
                  "dependency": {
                    "source": ["[^./]*", "[^./]*/**"]
                  }
                }
              },
              {
                "allow": {
                  "dependency": {
                    "source": "@everr/**"
                  }
                }
              },
              {
                "disallow": {
                  "dependency": {
                    "source": "@/**"
                  }
                }
              },
              {
                "allow": {
                  "to": {
                    "element": {
                      "path": "{{from.element.path}}"
                    }
                  }
                }
              },
              {
                "disallow": {
                  "dependency": {
                    "source": ["/**", "**/node_modules/**", "@/**/[.][.]/**"]
                  }
                }
              },
              {
                "disallow": {
                  "dependency": {
                    "source": "@composition/**"
                  }
                },
                "message": "Use a named composition module, not a directory alias."
              },
              {
                "from": {
                  "file": {
                    "path": "!packages/app/src/app/**"
                  }
                },
                "disallow": {
                  "to": {
                    "file": {
                      "path": "packages/app/src/app/**"
                    }
                  }
                },
                "message": "Access self-hosted implementation through @composition/* from shared code."
              },
              {
                "allow": {
                  "dependency": {
                    "source": "@composition/+([a-z])"
                  }
                }
              },
              {
                "disallow": {
                  "dependency": {
                    "source": "@everr/**"
                  },
                  "to": {
                    "file": {
                      "path": null
                    }
                  }
                },
                "message": "The package import must resolve through its public exports."
              },
              {
                "allow": {
                  "dependency": {
                    "source": "+([.]/|[.][.]/)**/*.md\\?raw"
                  }
                }
              },
              {
                "disallow": {
                  "to": {
                    "file": {
                      "path": "packages/app/src/lib/clickhouse.ts"
                    }
                  },
                  "dependency": [
                    {
                      "specifiers": [
                        "querySqlApi",
                        "querySqlApiWithMeta",
                        "previewSqlApi",
                        "runSqlApiQuery"
                      ]
                    },
                    {
                      "kind": "value",
                      "nodeKind": [
                        "dynamic-import",
                        "require",
                        "export",
                        "module-import",
                        "test-mock"
                      ]
                    }
                  ]
                },
                "message": "Use createOrganizationSql at the readiness boundary and pass its SQL access to callers.",
                "from": {
                  "file": {
                    "path": "!{packages/app/src/lib/organization-sql.ts,packages/cloud/src/clickhouse/provisioning.ts,**/*.test.{ts,tsx},**/test-setup.ts,**/testing/**}"
                  }
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
