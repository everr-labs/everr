{
  "name": "@everr/otel-profiler",
  "version": "0.0.0",
  "description": "Continuous Node.js profiling exported as OpenTelemetry profiles, linked to your traces",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/everr-labs/everr.git",
    "directory": "packages/otel-profiler"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test run",
    "test:ci": "vp test run",
    "test:watch": "vp test run --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@datadog/pprof": "5.20.0",
    "@opentelemetry/context-async-hooks": "^2.7.1",
    "@opentelemetry/core": "^2.7.1",
    "pprof-format": "2.4.0"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@types/node": "^25.6.2",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0"
  },
  "engines": {
    "node": ">=22"
  }
}
