{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@app/*": [
        "./src/cloud/app/*"
      ],
      "@everr/ui/*": [
        "../ui/src/*"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "src/app",
    "src/self-hosted",
    "src/routeTree.gen.ts"
  ]
}
