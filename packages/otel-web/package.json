{
  "name": "@everr/otel-web",
  "version": "0.1.0",
  "description": "Everr browser telemetry SDK: analytics, errors, and web vitals as OTel log records",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/everr-labs/everr.git",
    "directory": "packages/otel-web"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "node": "./src/server.ts",
      "default": "./src/index.ts"
    },
    "./react": "./src/react.ts"
  },
  "imports": {
    "#report": {
      "node": "./src/report.server.ts",
      "default": "./src/report.browser.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "node": {
          "types": "./dist/server.d.ts",
          "default": "./dist/server.js"
        },
        "default": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        }
      },
      "./react": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      }
    },
    "imports": {
      "#report": {
        "node": "./dist/report.server.js",
        "default": "./dist/report.browser.js"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "size": "tsdown && size-limit",
    "test": "vitest run",
    "test:ci": "vitest run",
    "test:watch": "vitest run --watch",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@everr/otel-errors": "workspace:*"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.218.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    },
    "@opentelemetry/api-logs": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.218.0",
    "@opentelemetry/context-async-hooks": "^2.7.1",
    "@opentelemetry/sdk-logs": "^0.218.0",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@size-limit/preset-small-lib": "^13.0.3",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "^4.1.5",
    "fast-check": "^4.9.0",
    "jsdom": "^29.1.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "size-limit": "^13.0.3",
    "tsdown": "^0.22.2",
    "typescript": "catalog:"
  }
}
