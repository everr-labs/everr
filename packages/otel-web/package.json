{
  "name": "@everr/otel-web",
  "version": "0.4.0",
  "description": "Everr browser telemetry SDK: analytics, errors, and web vitals as OTel log records",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/everr-labs/everr.git",
    "directory": "packages/otel-web"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "node": "./src/server.ts",
      "default": "./src/index.ts"
    },
    "./react": "./src/react.ts",
    "./recording": "./src/recording.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "node": {
          "types": "./dist/server.d.ts",
          "default": "./dist/server.js"
        },
        "default": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        }
      },
      "./react": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "./recording": {
        "types": "./dist/recording.d.ts",
        "default": "./dist/recording.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "size": "vp pack && size-limit",
    "test": "vp test run",
    "test:ci": "vp test run",
    "test:watch": "vp test run --watch",
    "test:coverage": "vp test run --coverage",
    "typecheck": "tsc --noEmit",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@everr/otel-errors": "workspace:*"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.218.0",
    "@opentelemetry/context-async-hooks": "^2.7.1",
    "@opentelemetry/sdk-logs": "^0.218.0",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@rrweb/record": "2.1.7",
    "@size-limit/preset-small-lib": "^13.0.3",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "fast-check": "^4.9.0",
    "jsdom": "^29.1.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "size-limit": "^13.0.3",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.218.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    },
    "@opentelemetry/api-logs": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
