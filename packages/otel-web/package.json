{
  "name": "@everr/otel-web",
  "version": "0.1.0",
  "description": "Everr browser telemetry SDK: analytics, errors, and web vitals as OTel log records",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/everr-labs/everr.git",
    "directory": "packages/otel-web"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "node": "./src/server.ts",
      "default": "./src/index.ts"
    },
    "./react": "./src/react.ts"
  },
  "scripts": {
    "build": "tsdown",
    "size": "tsdown && size-limit",
    "test": "vitest run",
    "test:ci": "vitest run",
    "test:watch": "vitest run --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@everr/auto-otel-errors": "workspace:*",
    "web-vitals": "^5.3.0"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.218.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    },
    "@opentelemetry/api-logs": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.218.0",
    "@opentelemetry/context-async-hooks": "^2.7.1",
    "@opentelemetry/sdk-logs": "^0.218.0",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@size-limit/preset-small-lib": "^13.0.3",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "^29.1.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "size-limit": "^13.0.3",
    "tsdown": "^0.22.2",
    "typescript": "catalog:"
  }
}
