{
  "extends": "@everr/app/tsconfig",
  "include": ["src", "*.ts", "scripts", "node_modules/@everr/app/src"],
  "compilerOptions": {
    "paths": {
      "@composition/storage": ["./src/app/composition/storage.ts"],
      "@composition/identity": ["./src/app/composition/identity.ts"],
      "@composition/layouts": ["./src/app/composition/layouts.tsx"],
      "@composition/pages": ["./src/app/composition/pages.tsx"],
      "@composition/ui": ["./src/app/composition/ui.tsx"],
      "@composition/client": ["./src/app/composition/client.tsx"],
      "@composition/product": ["./src/app/composition/product.ts"],
      "@composition/navigation": ["./src/app/composition/navigation.ts"],
      "@composition/dashboards": ["./src/app/composition/dashboards.ts"],
      "@composition/routes": ["./src/routeTree.gen.ts"],
      "@composition/runtime": ["./src/app/composition/runtime.ts"],
      "@composition/entry": ["./src/app/composition/entry.ts"],
      "@composition/deployment": ["./src/app/composition/deployment.ts"]
    }
  },
  "exclude": [
    "node_modules/@everr/app/src/app",
    "node_modules/@everr/app/src/routeTree.gen.ts"
  ]
}
