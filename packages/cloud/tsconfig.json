{
  "extends": "@everr/app/tsconfig",
  "include": [
    "src",
    "*.ts",
    "scripts",
    "node_modules/@everr/app/src"
  ],
  "compilerOptions": {
    "paths": {
      "@composition/client": [
        "./src/composition/client.tsx"
      ],
      "@/*": [
        "./node_modules/@everr/app/src/*"
      ],
      "@composition/product": [
        "./src/composition/product.ts"
      ],
      "@composition/ui": [
        "./src/composition/ui.ts"
      ],
      "@composition/server": [
        "./src/runtime.ts"
      ],
      "@composition/navigation": [
        "./src/navigation.ts"
      ],
      "@composition/dashboards": [
        "./src/dashboards.ts"
      ],
      "@composition/routes": [
        "./src/routeTree.gen.ts"
      ]
    }
  },
  "exclude": [
    "node_modules/@everr/app/src/app",
    "node_modules/@everr/app/src/routeTree.gen.ts"
  ]
}
