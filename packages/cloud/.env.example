# PostgreSQL
DATABASE_HOST="localhost"
DATABASE_NAME="postgres"
DATABASE_PORT="5432"
DATABASE_USER="postgres"
DATABASE_PASSWORD="postgres"
DATABASE_SSL="false"

# ClickHouse
CLICKHOUSE_URL="http://localhost:8123"
CLICKHOUSE_USERNAME="app_ro"
CLICKHOUSE_PASSWORD="app-dev"
CLICKHOUSE_DATABASE="app"
# Web-app admin: provisions per-org access
# entities (roles + row policies) for the /sql API. Tightly scoped: no SELECT
# on data, no GRANT OPTION on data privileges, can only administer roles it
# created itself.
CLICKHOUSE_ADMIN_USERNAME="web_app_admin"
CLICKHOUSE_ADMIN_PASSWORD="web-app-admin-dev"
# Cloud only: master key for deriving per-org ClickHouse /sql API passwords.
# Each organization gets a separate sql_api_org_<orgId> user.
CLICKHOUSE_SQL_API_MASTER_KEY="replace-with-a-long-random-value"
# Minimum 32 characters. Example: openssl rand -base64 24
BETTER_AUTH_SECRET="replace-with-a-long-random-value"
BETTER_AUTH_URL="http://localhost:5173"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub App install flow
GITHUB_APP_INSTALL_URL="https://github.com/apps/<your-app-slug>/installations/new"
# Minimum 32 characters. Example: openssl rand -base64 24
GITHUB_APP_STATE_SECRET="replace-with-a-long-random-value"
# Minimum 32 characters. Must match your GitHub App webhook secret.
GITHUB_APP_WEBHOOK_SECRET="replace-with-a-long-random-value"
# Found on your GitHub App's settings page (General → App ID)
GITHUB_APP_ID="123456"
# Generate a private key on your GitHub App's settings page, paste the .pem contents here
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# GitHub webhook worker
# Optional: forward GitHub webhooks from https://smee.io/<channel> to local dev.
SMEE_CHANNEL=
INGRESS_COLLECTOR_URL="http://localhost:8080/webhook/github"
INGRESS_SOURCE="github"
INGRESS_WORKER_COUNT="2"
INGRESS_WORKER_BATCH_SIZE="10"
INGRESS_MAX_ATTEMPTS="10"
INGRESS_POLL_INTERVAL="2s"
INGRESS_LOCK_DURATION="120s"
INGRESS_REPLAY_TIMEOUT="30s"
INGRESS_TENANT_CACHE_TTL="60s"
INGRESS_RETENTION_DONE_DAYS="7"
INGRESS_RETENTION_DEAD_DAYS="30"
INGRESS_CLEANUP_INTERVAL="1h"

# Required for deployed Cloud. The local pnpm dev stack supplies Mailpit settings.
EMAIL_DSN="smtps://smtp-user:smtp-password@smtp.example.com:465"
EMAIL_FROM="Everr <noreply+dev@everr.dev>"
EMAIL_REPLY_TO="hello@everr.dev"

POLAR_ACCESS_TOKEN=polar_oat_XXX
POLAR_WEBHOOK_SECRET="replace-with-a-long-random-value"
POLAR_SERVER="sandbox"
POLAR_PRO_PRODUCT_ID="replace-with-current-pro-product-id"
# Comma-separated Product IDs that still have active subscriptions.
POLAR_PRO_LEGACY_PRODUCT_IDS=

# Brevo CRM, server-only. Production and local development must use separate accounts.
# disabled: no admission or consumer; paused: admission only; configured: admission + consumer.
CRM_BREVO_MODE="disabled"
# Required in configured and paused modes. Never use the production key locally.
CRM_BREVO_API_KEY=
# Per-request deadline, including the response body, 100 to 30000 ms. Empty uses 10000.
CRM_BREVO_TIMEOUT_MS=10000


# Experimental
INGEST_VERIFY_SHARED_SECRET="replace-with-a-long-random-value"

# Telemetry
# OTEL_EXPORTER_OTLP_ENDPOINT is an unauthenticated custom collector override.
# For authenticated Everr ingest, set EVERR_INGEST_KEY. Cloud builds default to
# https://ingest.everr.dev. Self-hosted builds have no hosted default, so set
# EVERR_INGEST_ENDPOINT explicitly to use an Everr or local public receiver.
OTEL_EXPORTER_OTLP_ENDPOINT=
EVERR_INGEST_ENDPOINT=
EVERR_INGEST_KEY=
SERVICE_VERSION=
DEPLOYMENT_ENVIRONMENT=

# Browser telemetry (build-time, inlined into the client bundle by Vite).
# Public (origin-bound, ingest-only) `ek_` key. Safe to ship in the client
# bundle. When unset in a production build, browser error tracking stays off;
# in dev it falls back to the local collector. Cloud builds default to hosted
# ingest when a key is set. Self-hosted builds need an explicit endpoint to send
# outside development. Set VITE_EVERR_INGEST_ENDPOINT to select that destination.
VITE_EVERR_PUBLIC_INGEST_KEY=
VITE_EVERR_INGEST_ENDPOINT=

# Cloud advertises the shared collector at http://localhost:4318 in development
# and https://ingest.everr.dev/ in production.
