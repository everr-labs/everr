{
  "include": ["**/*.ts", "**/*.tsx"],
  // Pricing is shelved while plans are undecided: the route is excluded via
  // its "-" prefix, and its components stay in-tree but out of typecheck so
  // their links to the removed /pricing route don't break the build.
  // "node_modules" restores the default that an explicit exclude would drop.
  "exclude": [
    "node_modules",
    "src/routes/-pricing.tsx",
    "src/components/pricing-toggle.tsx",
    "src/components/pricing-matrix.tsx"
  ],
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["vite/client"],
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "allowJs": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@/*": ["./src/*"],
      "@everr/ui/*": ["../ui/src/*"],
      "fumadocs-mdx:collections/*": ["./.source/*"]
    },
    "noEmit": true
  }
}
