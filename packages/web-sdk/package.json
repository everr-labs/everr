{
  "name": "@everr/web-sdk",
  "version": "0.1.0",
  "description": "Everr browser telemetry SDK: analytics, errors, and web vitals as OTel log records",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/everr-labs/everr.git",
    "directory": "packages/web-sdk"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react.ts"
  },
  "scripts": {
    "build": "tsdown",
    "size": "tsdown && size-limit",
    "test": "vitest run",
    "test:ci": "vitest run",
    "test:watch": "vitest run --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "web-vitals": "^5.3.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^13.0.3",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "^29.1.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "size-limit": "^13.0.3",
    "tsdown": "^0.22.2",
    "typescript": "catalog:"
  }
}
