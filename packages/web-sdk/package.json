{
  "name": "@everr/web-sdk",
  "version": "0.1.0",
  "description": "Everr browser telemetry SDK: analytics, errors, and web vitals as OTel log records",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/everr-labs/everr.git",
    "directory": "packages/web-sdk"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
