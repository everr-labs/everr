{
  "name": "@everr/tanstack-start-otel",
  "version": "0.0.0",
  "description": "OpenTelemetry instrumentation for TanStack Start: SERVER spans with http.route, and server-function spans.",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.mts",
          "default": "./dist/index.mjs"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:ci": "vitest run",
    "test:watch": "vitest run --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@everr/otel-errors": "workspace:*"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@tanstack/react-start": ">=1.168.0"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@tanstack/react-start": "1.168.40",
    "@types/node": "^25.6.2",
    "tsdown": "^0.22.2",
    "typescript": "catalog:",
    "vitest": "^4.1.5"
  }
}
