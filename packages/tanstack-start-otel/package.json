{
  "name": "@everr/tanstack-start-otel",
  "version": "0.1.1",
  "description": "OpenTelemetry instrumentation for TanStack Start: SERVER spans with http.route, and server-function spans.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/everr-labs/everr.git",
    "directory": "packages/tanstack-start-otel"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.mts",
          "default": "./dist/index.mjs"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test run",
    "test:ci": "vp test run",
    "test:watch": "vp test run --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@everr/otel-errors": "workspace:*"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@tanstack/react-start": "1.168.60",
    "@types/node": "^25.6.2",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@tanstack/react-start": ">=1.168.0"
  }
}
