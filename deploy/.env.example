# Public addresses used in sign-in links and telemetry onboarding.
BETTER_AUTH_URL=http://localhost:3000
EVERR_PUBLIC_INGEST_URL=http://localhost:4318
# Bind locally by default. Use a TLS reverse proxy for remote access.
BIND_ADDRESS=127.0.0.1

# Optional: configure SMTP to deliver invitations and password-reset emails.
# Single-quote values containing a dollar sign. URL-encode SMTP credentials.
EMAIL_DSN=
EMAIL_FROM=

# Supported retention windows: 1, 7, 14, 30, 90, 180, 365 days.
EVERR_RETENTION_DAYS=30

# Generate each secret with `openssl rand -hex 32`.
POSTGRES_PASSWORD=replace-with-a-strong-random-value
CLICKHOUSE_PASSWORD=replace-with-a-strong-random-value
COLLECTOR_RW_PASSWORD=replace-with-a-strong-random-value
APP_RO_PASSWORD=replace-with-a-strong-random-value
WEB_APP_ADMIN_PASSWORD=replace-with-a-strong-random-value
CLICKHOUSE_SQL_API_USERNAME=sql_api
CLICKHOUSE_SQL_API_PASSWORD=replace-with-a-strong-random-value
BETTER_AUTH_SECRET=replace-with-a-strong-random-value
INGEST_VERIFY_SHARED_SECRET=replace-with-a-strong-random-value
