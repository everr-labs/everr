{
  "name": "everr",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @everr/app dev",
    "dev:cli": "pnpm --filter @everr/cli build:debug",
    "dev:docs": "pnpm --filter @everr/docs dev",
    "dev:storybook": "pnpm --filter @everr/storybook storybook",
    "check": "biome check",
    "check:fix": "biome check --fix",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "node scripts/publish-packages.mjs",
    "changeset:tag": "changeset tag",
    "postinstall": "lefthook install",
    "test": "vitest",
    "test:watch": "vitest --watch --ui",
    "dev:local": "pnpm --filter @everr/local-app dev",
    "dev:local:ui": "pnpm --filter @everr/local-app dev:ui",
    "build:cli": "pnpm --filter @everr/cli build:release"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@changesets/cli": "^2.31.0",
    "@vitest/coverage-v8": "^4.1.5",
    "@vitest/ui": "4.1.5",
    "fallow": "^2.75.0",
    "lefthook": "^2.1.6",
    "turbo": "^2.9.12",
    "vitest": "^4.1.5"
  },
  "packageManager": "pnpm@11.1.0"
}
