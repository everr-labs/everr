{
  "name": "everr",
  "private": true,
  "scripts": {
    "dev": "sh scripts/dev/start.sh",
    "dev:cli": "pnpm --filter @everr/cli build:debug",
    "dev:docs": "pnpm --filter @everr/docs dev",
    "dev:storybook": "pnpm --filter @everr/storybook storybook",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "node scripts/publish-packages.mjs",
    "changeset:tag": "changeset tag",
    "postinstall": "lefthook install",
    "test": "vp test",
    "test:ci": "vp test run --coverage.enabled=false",
    "test:watch": "vp test --watch --ui",
    "dev:local": "pnpm --filter @everr/local-app dev",
    "dev:local:ui": "pnpm --filter @everr/local-app dev:ui",
    "build:cli": "pnpm --filter @everr/cli build:release"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@tanstack/eslint-plugin-query": "^5.104.5",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "fallow": "^3.35.0",
    "lefthook": "^2.1.6",
    "oxlint-plugin-eslint": "^1.88.0",
    "portless": "0.15.8",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@12.15.0"
}
