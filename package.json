{
  "name": "everr",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @everr/app dev",
    "dev:desktop": "pnpm --filter @everr/desktop-app dev",
    "dev:cli": "pnpm --filter @everr/desktop-app build:cli:debug",
    "dev:docs": "pnpm --filter @everr/docs dev",
    "build:desktop": "pnpm --filter @everr/desktop-app build:desktop",
    "build:desktop:ci": "pnpm --filter @everr/desktop-app build:desktop:ci",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "changeset": "changeset",
    "changeset:version": "changeset version && node scripts/sync-desktop-app-version.mjs",
    "changeset:publish": "node scripts/publish-auto-otel-errors.mjs",
    "changeset:tag": "changeset tag",
    "postinstall": "lefthook install",
    "test": "vp test",
    "test:watch": "vp test --watch --ui"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@tanstack/eslint-plugin-query": "^5.101.2",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "fallow": "^2.75.0",
    "lefthook": "^2.1.6",
    "turbo": "^2.9.12",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.1.0"
}
